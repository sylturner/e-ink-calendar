# Optional: require Authorization: Bearer <this token> on /calendar.png
CALENDAR_API_TOKEN=choose-a-long-random-value

# Start with events from ./data/events.json, then switch to "google".
CALENDAR_SOURCE=file
TZ=America/New_York

# Typography preset: mono (default), sans, or serif.
# `mono` uses DejaVu Sans Mono, a bold terminal-style face that holds up well at 1-bit.
CALENDAR_FONT=mono

# Required only when CALENDAR_SOURCE=google. A single calendar can use these:
GOOGLE_CALENDAR_LABEL=Main
GOOGLE_CALENDAR_ID=primary

# Or use labeled calendars (this takes precedence over the two values above):
# GOOGLE_CALENDARS=Main=primary,Family=family-calendar-id@group.calendar.google.com,Spouse=spouse-calendar-id@group.calendar.google.com,Kids=kids-calendar-id@group.calendar.google.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
