# Leave blank to keep the browser dashboard open on your local network.
DASHBOARD_PASSWORD=

# One Google account, configured directly for this local installation.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Default selections used when a Google-backed component has no saved settings.
GOOGLE_CALENDAR_IDS=primary
GOOGLE_DOC_ID=

# Open-Meteo location, expressed as decimal coordinates.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_LOCATION=
