<div id="<%= dom_id dashboard_item %>">
  <div>
    <strong>Dashboard:</strong>
    <%= dashboard_item.dashboard_id %>
  </div>

  <div>
    <strong>Component key:</strong>
    <%= dashboard_item.component_key %>
  </div>

  <div>
    <strong>Settings:</strong>
    <%= dashboard_item.settings %>
  </div>

  <div>
    <strong>Grid x:</strong>
    <%= dashboard_item.grid_x %>
  </div>

  <div>
    <strong>Grid y:</strong>
    <%= dashboard_item.grid_y %>
  </div>

  <div>
    <strong>Grid width:</strong>
    <%= dashboard_item.grid_width %>
  </div>

  <div>
    <strong>Grid height:</strong>
    <%= dashboard_item.grid_height %>
  </div>

  <div>
    <strong>Enabled:</strong>
    <%= dashboard_item.enabled %>
  </div>

</div>
