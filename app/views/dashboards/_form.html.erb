<%= form_with(model: dashboard) do |form| %>
  <% if dashboard.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(dashboard.errors.count, "error") %> prohibited this dashboard from being saved:</h2>

      <ul>
        <% dashboard.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :theme, style: "display: block" %>
    <%= form.select :theme, Eink::Theme.options %>
  </div>

  <div>
    <%= form.label :grid_columns, style: "display: block" %>
    <%= form.number_field :grid_columns %>
  </div>

  <div>
    <%= form.label :grid_rows, style: "display: block" %>
    <%= form.number_field :grid_rows %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
