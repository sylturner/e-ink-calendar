#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_dir"

requested_source="${CALENDAR_SOURCE-}"
requested_events_file="${CALENDAR_EVENTS_FILE-}"

if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
fi

if [[ -n "$requested_source" ]]; then
  export CALENDAR_SOURCE="$requested_source"
fi

if [[ -n "$requested_events_file" ]]; then
  export CALENDAR_EVENTS_FILE="$requested_events_file"
fi
export APP_ENV=development
export RACK_ENV=development

port="${PORT:-4568}"

echo "Starting calendar development server at http://localhost:${port}"
echo "Watching Ruby, Rack, and event-data files for changes..."

exec bundle exec rerun \
  --dir . \
  --pattern '*.rb' \
  --pattern '*.ru' \
  --pattern '*.json' \
  --ignore 'vendor/*' \
  --ignore 'tmp/*' \
  -- bundle exec puma -p "$port" config.ru
