<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=800, height=480, initial-scale=1">
    <style><%= renderer.stylesheet %></style>
  </head>
  <body>
    <main class="calendar" style="--agenda-days: <%= renderer.days || 1 %>">
      <header class="masthead">
        <h1><%= renderer.bitmap_text(renderer.heading, size: 32, bold: true) %></h1>
        <p class="subtitle"><%= renderer.bitmap_text(renderer.subtitle, size: 16, bold: true) %></p>
      </header>

      <% if renderer.view == "month" %>
        <section class="month">
          <div class="weekday-labels"><% Date::ABBR_DAYNAMES.each do |name| %><span><%= renderer.bitmap_text(name, size: 16, bold: true) %></span><% end %></div>
          <div class="month-grid">
            <% renderer.month_weeks.flatten.each do |day| %>
              <article class="day-cell <%= "outside" unless day[:current_month] %>">
                <div class="day-number"><%= renderer.bitmap_text(day[:date].day.to_s, size: 16, bold: true) %></div>
                <ul class="event-list"><% day[:events].each do |event| %><li><%= renderer.bitmap_text(event, size: 16) %></li><% end %></ul>
              </article>
            <% end %>
          </div>
        </section>
      <% elsif renderer.view == "week" %>
        <section class="week">
          <% renderer.week_days.each do |day| %>
            <article class="day-cell">
              <div class="week-heading"><%= renderer.bitmap_text(day[:date].strftime("%a %-d"), size: 16, bold: true) %></div>
              <ul class="event-list"><% day[:events].each do |event| %><li><%= renderer.bitmap_text(event, size: 16) %></li><% end %></ul>
            </article>
          <% end %>
        </section>
      <% elsif renderer.view == "day" %>
        <section class="day-view">
          <% renderer.day_all_day_events.each do |event| %>
            <article class="event-row all-day"><span class="event-time"><%= renderer.bitmap_text("ALL DAY", size: 16, bold: true) %></span><span class="event-name"><%= renderer.bitmap_text(event.title, size: 16) %></span></article>
          <% end %>
          <% renderer.day_timed_events.each do |event| %>
            <article class="event-row"><span class="event-time"><%= renderer.bitmap_text(renderer.event_time(event), size: 16, bold: true) %></span><span class="event-name"><%= renderer.bitmap_text(event.title, size: 16) %></span></article>
          <% end %>
          <% if renderer.day_all_day_events.empty? && renderer.day_timed_events.empty? %><p class="empty"><%= renderer.bitmap_text("No events", size: 16) %></p><% end %>
        </section>
      <% elsif renderer.view == "agenda" %>
        <section class="agenda">
          <% renderer.agenda_days.each do |day| %>
            <article class="agenda-row">
              <div class="agenda-date">
                <span class="weekday"><%= renderer.bitmap_text(day[:date].strftime("%a").upcase, size: 16, bold: true) %></span>
                <span class="date"><%= renderer.bitmap_text(day[:date].strftime("%-d %b"), size: 16) %></span>
                <% if day[:today] %><span class="today"><%= renderer.bitmap_text("TODAY", size: 16, bold: true) %></span><% end %>
              </div>
              <div class="agenda-events">
                <% day[:events].each do |event| %>
                  <div class="agenda-event"><span class="calendar-tag"><%= renderer.bitmap_text(renderer.calendar_tag(event), size: 16, bold: true) %></span><span class="event-name"><%= renderer.bitmap_text(renderer.event_text(event), size: 16, bold: true) %></span></div>
                <% end %>
              </div>
            </article>
          <% end %>
        </section>
      <% end %>
    </main>
  </body>
</html>
